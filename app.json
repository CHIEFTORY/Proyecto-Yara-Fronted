{
  "expo": {
    "name": "Yara",
    "slug": "yara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/yara_app_icon_blue.png",
    "scheme": "yara",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/yara_android_foreground_blue.png",

        "monochromeImage": "./assets/images/yara_monochrome_blue.png"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/yara_app_icon_blue.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],

      "expo-secure-store",

      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}