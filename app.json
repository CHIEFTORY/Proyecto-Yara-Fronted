{
  "expo": {
    "name": "Yara",
    "slug": "yara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/yara-icon-final.png",
    "scheme": "yara",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7f97f53c-3c6f-439a-99c3-f4aabfa07b98"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mauricioparra.yara",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#082E74",
        "backgroundImage": "./assets/images/yara-adaptive-background-final.png",
        "foregroundImage": "./assets/images/yara-adaptive-foreground-final.png",
        "monochromeImage": "./assets/images/yara-monochrome-final.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/yara-favicon-final.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/yara-splash-logo-final.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#082E74"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/yara-monochrome-final.png",
          "color": "#2563EB",
          "defaultChannel": "actividad"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f97f53c-3c6f-439a-99c3-f4aabfa07b98"
      }
    }
  }
}
